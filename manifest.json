{
  "manifest_version": 3,
  "name": "Web AI Assistant",
  "version": "1.0.0",
  "description": "Posez vos questions sur la page web que vous consultez, ou sur une recherche web, et obtenez des réponses des modèles hébergés par Mistral (Mistral Small 4, Mistral Medium 3.5, GLM 5.2).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir Web AI Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.mistral.ai/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdf.min.js", "vendor/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
