{
  "manifest_version": 3,
  "name": "Web AI Assistant",
  "version": "1.0.0",
  "description": "Posez vos questions sur la page web que vous consultez, ou transcrivez l'audio d'une vidéo de l'onglet actif (avec diarisation), via les modèles hébergés par Mistral.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir Web AI Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": [
    "https://api.mistral.ai/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdf.min.js", "vendor/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
